# Copy to backend/.env and uncomment ONE credential block.
# Leave everything commented out to use your Claude Code login (default).
# Restart the backend after changing this file.

## --- Anthropic Console API key ---------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

## --- DeepSeek (native Anthropic-compatible endpoint) ------------------------
## (real values go in .env — this file is just a template and is NOT gitignored)


## --- Any other provider, via an Anthropic-compatible gateway ---------------
## Run a gateway such as LiteLLM (`litellm --port 4000`) with your OpenAI/
## Gemini/local keys configured in it, then point the office at it:
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_AUTH_TOKEN=sk-litellm-...
## With a gateway, set the models below to the gateway's model names.

## --- Claude on AWS Bedrock or GCP Vertex ------------------------------------
## Uses your cloud credentials (aws configure / gcloud auth).
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

## --- Per-agent models --------------------------------------------------------
## Aliases ("sonnet", "haiku", "opus") or full model IDs; with a gateway,
## whatever model names the gateway exposes.
# PM_MODEL=sonnet
# CODER_MODEL=sonnet
# REVIEWER_MODEL=haiku

## --- Sandbox images ----------------------------------------------------------
## Container image for Flutter-stack goals. The default is multi-arch
## (amd64 + arm64) and ~3 GB — pre-pull it before the first Flutter goal:
##   docker pull ghcr.io/cirruslabs/flutter:stable
# FLUTTER_SANDBOX_IMAGE=ghcr.io/cirruslabs/flutter:stable


