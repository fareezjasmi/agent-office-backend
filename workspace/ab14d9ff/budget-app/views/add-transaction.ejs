<div class="page-header">
  <h1><%= editing ? 'Edit Transaction' : 'Add Transaction' %></h1>
  <a href="/transactions" class="btn btn-small btn-secondary">Back to List</a>
</div>

<% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach(function(e) { %>
        <li><%= e %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="card form-card">
  <form method="POST" action="/transactions<%= editing ? '/' + transaction.id : '' %>" class="transaction-form">
    <div class="form-group">
      <label for="type">Type</label>
      <select id="type" name="type" required>
        <option value="expense" <%= (!transaction || transaction.type === 'expense') ? 'selected' : '' %>>Expense</option>
        <option value="income" <%= (transaction && transaction.type === 'income') ? 'selected' : '' %>>Income</option>
      </select>
    </div>

    <div class="form-group">
      <label for="category">Category</label>
      <input type="text" id="category" name="category" list="category-list" value="<%= transaction ? transaction.category : '' %>" placeholder="e.g. Food, Rent, Salary" required>
      <datalist id="category-list">
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>">
        <% }); %>
        <option value="Food & Dining">
        <option value="Housing">
        <option value="Transportation">
        <option value="Utilities">
        <option value="Entertainment">
        <option value="Healthcare">
        <option value="Shopping">
        <option value="Salary">
        <option value="Freelance">
        <option value="Investments">
        <option value="Other">
      </datalist>
    </div>

    <div class="form-group">
      <label for="amount">Amount ($)</label>
      <input type="number" id="amount" name="amount" step="0.01" min="0.01" value="<%= transaction ? transaction.amount : '' %>" placeholder="0.00" required>
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input type="date" id="date" name="date" value="<%= transaction ? transaction.date : today %>" required>
    </div>

    <div class="form-group">
      <label for="description">Description (optional)</label>
      <input type="text" id="description" name="description" value="<%= transaction ? transaction.description : '' %>" placeholder="What was this for?">
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= editing ? 'Update' : 'Add' %> Transaction</button>
      <a href="/transactions" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
