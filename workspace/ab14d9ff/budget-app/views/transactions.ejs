<div class="page-header">
  <h1>Transactions</h1>
  <a href="/transactions/add" class="btn btn-primary">+ Add Transaction</a>
</div>

<!-- Summary -->
<div class="summary-cards summary-small">
  <div class="card card-income">
    <div class="card-label">Income</div>
    <div class="card-value">$<%= Number(summary.income).toFixed(2) %></div>
  </div>
  <div class="card card-expense">
    <div class="card-label">Expenses</div>
    <div class="card-value">$<%= Number(summary.expense).toFixed(2) %></div>
  </div>
  <div class="card card-balance">
    <div class="card-label">Net</div>
    <div class="card-value <%= (summary.income - summary.expense) >= 0 ? 'positive' : 'negative' %>">
      $<%= Number(summary.income - summary.expense).toFixed(2) %>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="card filters-card">
  <form method="GET" action="/transactions" class="filters-form">
    <div class="filter-group">
      <label for="month">Month</label>
      <input type="month" id="month" name="month" value="<%= filters.month %>">
    </div>
    <div class="filter-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }); %>
      </select>
    </div>
    <div class="filter-group">
      <label for="type">Type</label>
      <select id="type" name="type">
        <option value="">All</option>
        <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>Income</option>
        <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>Expense</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="sort">Sort</label>
      <select id="sort" name="sort">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
      </select>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn btn-small">Filter</button>
      <a href="/transactions" class="btn btn-small btn-secondary">Clear</a>
    </div>
  </form>
</div>

<!-- Transactions Table -->
<div class="card">
  <% if (transactions.length === 0) { %>
    <p class="empty-state">No transactions found. <a href="/transactions/add">Add one now</a>.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Category</th>
          <th>Description</th>
          <th class="text-right">Amount</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(function(t) { %>
          <tr>
            <td><%= t.date %></td>
            <td><span class="type-badge type-<%= t.type %>"><%= t.type %></span></td>
            <td><span class="category-badge"><%= t.category %></span></td>
            <td><%= t.description || '—' %></td>
            <td class="text-right <%= t.type === 'income' ? 'income-text' : 'expense-text' %>">
              <%= t.type === 'income' ? '+' : '-' %>$<%= Number(t.amount).toFixed(2) %>
            </td>
            <td class="text-center">
              <a href="/transactions/<%= t.id %>/edit" class="btn btn-small btn-secondary">Edit</a>
              <form method="POST" action="/transactions/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this transaction?')">
                <button type="submit" class="btn btn-small btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
