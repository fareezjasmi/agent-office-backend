<div class="page-header">
  <h1>Dashboard</h1>
  <form method="GET" action="/" class="month-picker">
    <label for="month">Month:</label>
    <input type="month" id="month" name="month" value="<%= month %>" onchange="this.form.submit()">
  </form>
</div>

<!-- Summary Cards -->
<div class="summary-cards">
  <div class="card card-income">
    <div class="card-label">Income</div>
    <div class="card-value">$<%= Number(income).toFixed(2) %></div>
  </div>
  <div class="card card-expense">
    <div class="card-label">Expenses</div>
    <div class="card-value">$<%= Number(expense).toFixed(2) %></div>
  </div>
  <div class="card card-balance">
    <div class="card-label">Balance</div>
    <div class="card-value <%= balance >= 0 ? 'positive' : 'negative' %>">$<%= Number(balance).toFixed(2) %></div>
  </div>
</div>

<div class="dashboard-grid">
  <!-- Category Breakdown Chart -->
  <div class="card chart-card">
    <h2>Spending by Category</h2>
    <canvas id="categoryChart" width="300" height="300"></canvas>
    <% if (categoryBreakdown.length === 0) { %>
      <p class="empty-state">No expenses recorded this month.</p>
    <% } %>
  </div>

  <!-- Budget Progress -->
  <div class="card">
    <h2>Budget Progress</h2>
    <% if (budgets.length === 0) { %>
      <p class="empty-state"><a href="/budgets">Set up budgets</a> to track your spending limits.</p>
    <% } %>
    <% budgets.forEach(function(b) { %>
      <div class="budget-item">
        <div class="budget-header">
          <span class="budget-category"><%= b.category %></span>
          <span class="budget-amount">$<%= Number(b.spent).toFixed(0) %> / $<%= Number(b.limit).toFixed(0) %></span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill <%= b.pct >= 100 ? 'over-budget' : b.pct >= 80 ? 'warning' : '' %>" style="width: <%= b.pct %>%"></div>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<!-- Recent Transactions -->
<div class="card">
  <div class="card-header">
    <h2>Recent Transactions</h2>
    <a href="/transactions" class="btn btn-small">View All</a>
  </div>
  <% if (recentTransactions.length === 0) { %>
    <p class="empty-state">No transactions yet. <a href="/transactions/add">Add your first transaction</a>.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Category</th>
          <th>Description</th>
          <th class="text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% recentTransactions.forEach(function(t) { %>
          <tr>
            <td><%= t.date %></td>
            <td><span class="category-badge"><%= t.category %></span></td>
            <td><%= t.description || '—' %></td>
            <td class="text-right <%= t.type === 'income' ? 'income-text' : 'expense-text' %>">
              <%= t.type === 'income' ? '+' : '-' %>$<%= Number(t.amount).toFixed(2) %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const ctx = document.getElementById('categoryChart');
  if (ctx) {
    const data = <%- JSON.stringify(categoryBreakdown) %>;
    if (data.length > 0) {
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: data.map(d => d.category),
          datasets: [{
            data: data.map(d => d.total),
            backgroundColor: [
              '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
              '#FF9F40', '#C9CBCF', '#7BC8A4', '#E07B91', '#5FA8D3'
            ]
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: 'right' }
          }
        }
      });
    }
  }
});
</script>
