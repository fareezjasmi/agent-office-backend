<div class="page-header">
  <h1>Reports</h1>
  <form method="GET" action="/reports" class="month-picker">
    <label for="month">Month:</label>
    <input type="month" id="month" name="month" value="<%= month %>" onchange="this.form.submit()">
  </form>
</div>

<div class="report-grid">
  <!-- Monthly Summary -->
  <div class="card report-card">
    <h2>Monthly Summary</h2>
    <canvas id="monthlyChart"></canvas>
  </div>

  <!-- Category Breakdown -->
  <div class="card report-card">
    <h2>Expense Categories</h2>
    <canvas id="categoryReportChart"></canvas>
  </div>

  <!-- Monthly Trends (full width) -->
  <div class="card report-card full-width">
    <h2>Monthly Trends</h2>
    <canvas id="trendsChart" height="80"></canvas>
  </div>

  <!-- Daily Breakdown (full width) -->
  <div class="card report-table-card full-width">
    <h2>Daily Breakdown &mdash; <%= month %></h2>
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th class="text-right">Income</th>
          <th class="text-right">Expenses</th>
          <th class="text-right">Net</th>
        </tr>
      </thead>
      <tbody id="daily-tbody">
        <tr><td colspan="4" class="text-center" style="color: var(--color-text-light)">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const month = '<%= month %>';

  // Fetch monthly summary
  fetch('/api/reports/monthly?month=' + month)
    .then(r => r.json())
    .then(data => {
      const ctx = document.getElementById('monthlyChart');
      if (!ctx) return;
      if (data.income === 0 && data.expense === 0 && data.balance === 0) {
        ctx.style.display = 'none';
        const msg = document.createElement('p');
        msg.className = 'empty-state';
        msg.textContent = 'No data for this month.';
        ctx.parentElement.appendChild(msg);
        return;
      }
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Income', 'Expenses', 'Balance'],
          datasets: [{
            data: [data.income, data.expense, data.balance],
            backgroundColor: ['#2ec4b6', '#e63946', '#4361ee'],
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { callback: v => '$' + v.toFixed(0) } }
          }
        }
      });

      // Daily table
      const tbody = document.getElementById('daily-tbody');
      tbody.innerHTML = '';
      if (data.dailyTotals.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center" style="color: var(--color-text-light)">No data for this month.</td></tr>';
      } else {
        data.dailyTotals.forEach(function(d) {
          const net = d.income - d.expense;
          tbody.innerHTML += '<tr>' +
            '<td>' + d.date + '</td>' +
            '<td class="text-right income-text">$' + Number(d.income).toFixed(2) + '</td>' +
            '<td class="text-right expense-text">$' + Number(d.expense).toFixed(2) + '</td>' +
            '<td class="text-right ' + (net >= 0 ? 'income-text' : 'expense-text') + '">$' + Number(net).toFixed(2) + '</td>' +
            '</tr>';
        });
      }
    });

  // Fetch category breakdown
  fetch('/api/reports/categories?month=' + month + '&type=expense')
    .then(r => r.json())
    .then(data => {
      const ctx = document.getElementById('categoryReportChart');
      if (!ctx) return;
      if (data.breakdown.length === 0) {
        document.querySelector('.report-card:nth-child(2)').innerHTML += '<p class="empty-state">No expenses this month.</p>';
        return;
      }
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: data.breakdown.map(d => d.category),
          datasets: [{
            data: data.breakdown.map(d => d.total),
            backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#C9CBCF', '#7BC8A4', '#E07B91', '#5FA8D3']
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: 'right', labels: { font: { size: 11 } } }
          }
        }
      });
    });

  // Fetch trends
  fetch('/api/reports/trends?months=6')
    .then(r => r.json())
    .then(data => {
      const ctx = document.getElementById('trendsChart');
      if (!ctx) return;
      if (data.months.length === 0) {
        ctx.style.display = 'none';
        const msg = document.createElement('p');
        msg.className = 'empty-state';
        msg.textContent = 'No trend data available.';
        ctx.parentElement.appendChild(msg);
        return;
      }
      const months = data.months.reverse();
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: months.map(m => m.month),
          datasets: [
            { label: 'Income', data: months.map(m => m.income), borderColor: '#2ec4b6', backgroundColor: 'rgba(46,196,182,0.1)', fill: true, tension: 0.3 },
            { label: 'Expenses', data: months.map(m => m.expense), borderColor: '#e63946', backgroundColor: 'rgba(230,57,70,0.1)', fill: true, tension: 0.3 },
            { label: 'Balance', data: months.map(m => m.balance), borderColor: '#4361ee', backgroundColor: 'rgba(67,97,238,0.1)', fill: true, tension: 0.3 }
          ]
        },
        options: {
          responsive: true,
          interaction: { intersect: false, mode: 'index' },
          plugins: { legend: { position: 'bottom' } },
          scales: {
            y: { beginAtZero: true, ticks: { callback: v => '$' + v.toFixed(0) } }
          }
        }
      });
    });
});
</script>
